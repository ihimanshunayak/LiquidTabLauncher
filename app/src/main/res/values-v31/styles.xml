<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 31 adds the switches that stop the platform from painting its own
      contrast scrim behind the status and navigation bars. The launcher draws
      its own contrast against arbitrary wallpaper, so the scrim is only ever
      wrong; it stays on below 31, where the switches don't exist.
    -->
    <style name="Theme.LiquidTab" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.LiquidTab.Transparent" parent="Theme.LiquidTab">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>
</resources>
