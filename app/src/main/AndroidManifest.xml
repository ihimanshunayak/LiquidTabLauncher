<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid Tab Launcher — the FreeMusic design system as a tablet Home app.

  Four things make this a launcher rather than a normal app:

   1. HomeActivity claims ACTION_MAIN + CATEGORY_HOME + CATEGORY_DEFAULT, so
      Android offers it as a Home app on the default-home chooser.
   2. WelcomeActivity claims ACTION_MAIN + CATEGORY_LAUNCHER, so the app has
      an icon in the app drawer and can be opened before it holds the Home
      role. A launcher needs both: Home for the system, LAUNCHER for the user.
   3. A <queries> element declares what the launcher may see across packages:
      launchable apps for the workspace/library/search, and the media3 service
      actions so the Now Playing widget can reach the FreeMusic player.
      QUERY_ALL_PACKAGES is deliberately NOT used — it is a Play-policy
      restricted permission and visibility of launchable apps is all a
      launcher actually needs.
   4. Both entry points are exported and both carry a label, so the app is
      reachable from Settings > Apps on any device, including one where the
      Home role was never granted.

  Permissions are kept to the minimum the features actually use: the network
  for the weather widget, boot to restart the clock, a calendar read that the
  calendar widget asks for in place, and the two device controls the Quick
  Controls panel offers. The launcher reads no wallpaper permission — it paints
  its own background stack (and offers a photo picker for a personal image)
  rather than reaching for the system wallpaper.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Every long press on the Home screen plays a haptic, and a launcher is
      built out of long presses. Without this the vibrate call throws
      SecurityException on the main thread and takes the launcher down with it,
      so this is not a nicety — it is the difference between a Home screen that
      responds to a press-and-hold and one that crashes on it.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      The calendar widget's read. Declared here even though nothing asks for it
      at launch: a runtime request for a permission that is absent from the
      manifest is answered with an immediate denial and no dialog, so without
      this line the widget's own "Grant access" button could never work.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!--
      Quick Controls asks for these only when the user taps the corresponding
      tile; the launcher functions fully without either being granted.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      WRITE_SETTINGS is a special permission: it is never granted from a dialog,
      only from the Settings screen the brightness tile opens. It is declared
      so the tile can offer to open that screen, and the tile works without it
      by writing the window-level brightness instead.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="androidx.media3.session.MediaLibraryService" />
        </intent>
        <intent>
            <action android:name="androidx.media3.session.MediaSessionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".LiquidTabApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidTab">

        <!--
          The app-drawer entry point, and the only exported activity that is
          not Home. Without it this app would install completely and then be
          unreachable: a launcher that declares only CATEGORY_HOME has no icon
          anywhere until the user has already made it their Home app, and a
          user cannot make an app Home without first being able to open it.
          This activity breaks that circular dependency, and stays useful
          afterwards as the way back to Settings from outside the launcher.

          `taskAffinity=""` keeps it out of the Home task so backing out of it
          cannot leave the Home screen with nothing to return to.
        -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LiquidTab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Home activity itself. `stateNotNeeded` and `excludeFromRecents`
          are the launcher contract: the Home app is always alive, so Android
          must not try to restore it into a saved state, and it must never
          appear in its own recents list. `launchMode` singleTask keeps every
          Home press targeting one instance — without it, repeated Home presses
          can stack duplicate homes.

          Orientation and size changes are handled in place rather than by
          recreating the activity: a launcher rebuilds its whole workspace on
          recreate, and rotation happens many times a day.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LiquidTab.Transparent">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Settings, reachable from the launcher, from WelcomeActivity and from
          Settings > Apps. Not exported — launchers never advertise their own
          preferences to the system launcher list.
        -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.LiquidTab" />

        <!--
          A reboot invalidates nothing the launcher persists, but the clock and
          date widgets should re-read immediately rather than at the next tick.
        -->
        <receiver
            android:name=".widgets.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
